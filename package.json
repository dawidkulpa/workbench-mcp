{
  "name": "workbench-mcp",
  "version": "1.0.0",
  "description": "A self-hosted MCP server providing secure, stateful TypeScript sandbox sessions for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "llm",
    "sandbox",
    "docker",
    "typescript"
  ],
  "author": "Dawid Kulpa",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.56.0",
    "dockerode": "4.0.2",
    "fastify": "4.28.1",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.31",
    "@types/node": "20.17.12",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
